# ── Required ────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgres://abcarino:abcarino@localhost:5432/abcarino

# Public base URL of the website (used for canonical URLs, sitemap, OG tags)
APP_URL=http://localhost:3000

# Long random secret (≥ 32 chars). Generate with: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters

# ── Optional ────────────────────────────────────────────────────────────
# Where uploaded media is stored (must be persistent in production)
STORAGE_DIR=./storage

# Set to "true" only behind a reverse proxy that overwrites X-Real-IP (see DEPLOYMENT.md).
# Defaults to true on Vercel.
TRUST_PROXY=false

# Initial super admin (used by `npm run db:seed` / `npm run admin:create`)
ADMIN_EMAIL=admin@abcarino.com
ADMIN_NAME="ABCARINO Admin"
# Leave empty to have a strong password generated and printed once.
ADMIN_PASSWORD=

# ── Vercel / serverless ─────────────────────────────────────────────────
# Required on Vercel: uploaded media is stored in Vercel Blob (create a Blob store
# in the Storage tab and connect it; Vercel adds one of these automatically).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
# Set to "false" when DATABASE_URL points to a transaction-mode pooler that
# doesn't support prepared statements (auto-detected for PgBouncer/Neon/Supabase).
DATABASE_PREPARE=
# Connections per app instance (default 10; 3 on Vercel).
DATABASE_POOL_SIZE=
